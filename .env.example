# Oxford 3000 Platform - Environment Configuration
# Put your private API keys here. They will be loaded automatically and permanently by Vite.

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=

# Groq API Key (https://console.groq.com/keys)
VITE_GROQ_API_KEY=

# NVIDIA NIM API Key (https://build.nvidia.com)
VITE_NVIDIA_API_KEY=

# Pexels Image API Key (Optional)
VITE_PEXELS_API_KEY=
